<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_surface"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
    <ImageView android:id="@+id/widget_art" android:layout_width="106dp" android:layout_height="106dp" android:background="@drawable/widget_art_empty" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/ic_widget_note"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="0dp" android:orientation="vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="FoYu" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:text="@string/widget_idle" android:textColor="#D9FFFFFF" android:textSize="14sp"/>
</LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/widget_previous" android:layout_width="42dp" android:layout_height="42dp"  android:background="@drawable/widget_round_button" android:contentDescription="@string/widget_previous" android:scaleType="center" android:src="@drawable/ic_widget_previous"/>
        <FrameLayout android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp">
          
<FrameLayout android:id="@+id/widget_play" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/widget_play">
  <ImageView android:id="@+id/widget_play_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_pill"/>
  <ImageView android:id="@+id/widget_play_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_widget_play" android:tint="#FF11131B"/>
</FrameLayout>
        </FrameLayout>
        <ImageButton android:id="@+id/widget_next" android:layout_width="42dp" android:layout_height="42dp"  android:background="@drawable/widget_round_button" android:contentDescription="@string/widget_next" android:scaleType="center" android:src="@drawable/ic_widget_next"/>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
