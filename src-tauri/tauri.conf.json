{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PocketPod",
  "version": "0.2.0",
  "identifier": "com.pocketpod.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PocketPod",
        "width": 380,
        "height": 680,
        "minWidth": 280,
        "minHeight": 500,
        "maxWidth": 380,
        "maxHeight": 680,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PocketPod",
    "shortDescription": "Un iPod para controlar Spotify y Apple Music en Windows",
    "longDescription": "PocketPod es un reproductor con forma de iPod clÃ¡sico que controla Spotify y Apple Music: pantalla Now Playing, historial de canciones y rueda click. Disponible para Windows y Android.",
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
