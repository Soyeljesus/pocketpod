{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoYu",
  "version": "0.5.3",
  "identifier": "com.pocketpod.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FoYu",
        "width": 1200,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FoYu",
    "shortDescription": "Toda tu música en un solo lugar",
    "longDescription": "FoYu reúne tu música, tus playlists y tu biblioteca en un reproductor para Windows y Android.",
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
